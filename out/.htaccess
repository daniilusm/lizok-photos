# REG.RU Linux hosting (Apache behind nginx).
# Upload this file to the site root together with the contents of out/.

Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# 1) One canonical host: www → apex (matches SEO: https://lizok-a-ph.ru)
RewriteCond %{HTTP_HOST} ^www\.lizok-a-ph\.ru$ [NC]
RewriteRule ^ https://lizok-a-ph.ru%{REQUEST_URI} [R=301,L]

# 2) Existing files/dirs — serve as is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3) Unknown path → custom 404 page
RewriteRule ^ /404/ [R=302,L]

# Fallback if rewrite for missing files is off
ErrorDocument 404 /404.html
