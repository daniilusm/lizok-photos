# Минимальная конфигурация для static deploy на Vercel
# См. docs/VERCEL_DEPLOY.md

NEXT_PUBLIC_SITE_URL=https://lizok-a-ph.ru
NEXT_PUBLIC_APP_ENV=production

# Cloudinary (Admin API — только на сервере / при build)
NEXT_PUBLIC_CLOUDINARY_PROJECTS_ID=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# либо NEXT_PUBLIC_CLOUDINARY_KEY= (как fallback для API key)

# --- Не нужны для static deploy (Strapi / imgproxy отключены) ---
# NEXT_PUBLIC_STRAPI_URL=
# NEXT_PUBLIC_NETWORK_STRAPI_URL=
# NEXT_PUBLIC_STRAPI_API_TOKEN=
# PREVIEW_SECRET=
# IMGPROXY_URL=
# IMGPROXY_KEY=
# IMGPROXY_SALT=

# --- Аналитика ---
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_YANDEX_TRACKING_ID=
# Без NEXT_PUBLIC_APP_ENV=production Метрика раньше не подключалась (см. AppHooks)

# --- Форма контактов (SMTP) ---
# На REG.RU: скопируйте public/send-contact.config.example.php
# → public/send-contact.config.php и заполните SMTP ящика.
# Опционально свой endpoint:
# NEXT_PUBLIC_CONTACT_API_URL=/send-contact.php
# NEXT_PUBLIC_REVIEW_API_URL=/send-review.php
#
# Для Node (не static export): SMTP_* ниже + pages API
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_CONTACT_FORM_EMAIL=
