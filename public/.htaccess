# REG.RU Linux hosting — upload to site root with contents of out/

Options -Indexes -MultiViews
RewriteEngine On
RewriteBase /

# Canonical host: www → without www
RewriteCond %{HTTP_HOST} ^www\.lizok-a-ph\.ru$ [NC]
RewriteRule ^ https://lizok-a-ph.ru%{REQUEST_URI} [R=301,L]

# Missing path → HTTP 404, then ErrorDocument serves frozen custom page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

# Frozen custom page (no Next.js scripts — cannot hydrate into default 404)
ErrorDocument 404 /404.html
